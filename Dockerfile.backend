# Backend image — FastAPI + gitclaw + git + Python scripts.
#
# This is the "engine" container: it serves the HTTP API AND hosts gitclaw
# (the Node.js agent runtime that does the actual LLM work).
#
# Why both Python and Node in one image?
#   - server/main.py is Python (FastAPI)
#   - server spawns gitclaw subprocess (which is Node)
#   - subprocess pattern means they must be co-located

FROM python:3.12-slim

# System deps: git (audit trail), curl (Node install), build tools (for pandas)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install gitclaw globally (Node CLI)
RUN npm install -g gitclaw@latest

# Configure git for committing inside the container
RUN git config --global user.email "agent@portfolio-council.local" \
    && git config --global user.name "Portfolio Council Agent" \
    && git config --global init.defaultBranch main \
    && git config --global --add safe.directory /app

WORKDIR /app

# Install Python deps (cached layer — only rebuilds when requirements change)
COPY server/requirements.txt /tmp/server-requirements.txt
RUN pip install --no-cache-dir -r /tmp/server-requirements.txt

# Install script deps (yfinance, pandas) — required by skills. Fail loudly
# if any package can't install: a silent failure here meant analyst runs
# crashed at runtime with ModuleNotFoundError on yfinance, which broke the
# headline "live NSE prices" claim during demos.
COPY requirements.txt /tmp/repo-requirements.txt
RUN pip install --no-cache-dir -r /tmp/repo-requirements.txt

# Repo gets bind-mounted at runtime via docker-compose.
# Server code lives at /app/server.

WORKDIR /app/server

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
