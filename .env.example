# Portfolio Council — environment template.
#
# Copy this file to .env and fill in your LLM credentials.
# The .env file is gitignored and never committed.
#
#   cp .env.example .env
#   nano .env
#   docker compose up

# ─── PRIMARY: AWS Bedrock (Claude Sonnet 4.5) ──────────────────────
# The agents default to Claude Sonnet 4.5 via Bedrock. To enable it:
#
#   1. Have an AWS account with Bedrock access (us-east-1).
#   2. Enable model access for "Claude Sonnet 4.5" in the Bedrock console:
#      https://console.aws.amazon.com/bedrock/home?#/modelaccess
#   3. Create a Bedrock API key in IAM (this is the newer 2025 bearer-token
#      auth, NOT a traditional AWS access key). Or get one from Lyzr Studio.
#   4. Paste it below.

AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-east-1

# ─── FALLBACK: Azure OpenAI ────────────────────────────────────────
# Optional. The agents will fall back to this if Bedrock is unset.
# If you have neither, the system can't run sessions (but the UI still loads).

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=preview
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=gpt-5-mini=gpt-5-mini

# ─── OPTIONAL: Telegram bot notifications (v2 roadmap) ──────────────
# Skip this for now — not wired up in v1.
#
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
